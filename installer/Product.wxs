<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="NDifference"
           Language="1033"
           Manufacturer="deejaygraham"
           Version="!(bind.fileVersion.NDifferenceUiDll)"
           UpgradeCode="d73c1b74-0456-409a-9a66-f4366410ad29"
           Scope="perMachine">

    <SummaryInformation Description="NDifference Windows Installer" />
    <MajorUpgrade DowngradeErrorMessage="A later version of [ProductName] is already installed." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="APPLICATIONROOTDIRECTORY" Name="NDifference" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramShortcutsDirectory" Name="NDifference">
        <Component Id="ApplicationShortcut" Guid="{C77AD643-7D38-4552-8A37-1DF40762AEB9}">
          <Shortcut Id="ProgramStartMenuShortcut"
                    Name="NDifference"
                    Description="Public API Reporting for .NET"
                    Target="[APPLICATIONROOTDIRECTORY]NDifference.UI.exe"
                    WorkingDirectory="APPLICATIONROOTDIRECTORY"
                    Icon="NDifferenceIcon" />
          <RemoveFolder Id="RemoveProgramShortcutsDirectory" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\NDifference"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Keep a stable file id for version binding; harvest the rest of the publish output. -->
    <File Id="NDifferenceUiDll"
          Source="$(PublishDir)\NDifference.UI.dll"
          Directory="APPLICATIONROOTDIRECTORY" />

    <Files Include="$(PublishDir)\**" Directory="APPLICATIONROOTDIRECTORY">
      <Exclude Files="$(PublishDir)\NDifference.UI.dll" />
      <Exclude Files="$(PublishDir)\**\*.pdb" />
    </Files>

    <Icon Id="NDifferenceIcon" SourceFile="$(IconFilePath)" />
    <Property Id="ARPPRODUCTICON" Value="NDifferenceIcon" />
    <Property Id="ARPHELPLINK" Value="https://deejaygraham.github.io/ndifference/" />

    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />

    <UI>
      <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="APPLICATIONROOTDIRECTORY" />

      <!-- There is no license file to display, so bypass the standard license dialog. -->
      <Publish Dialog="WelcomeDlg"
               Control="Next"
               Event="NewDialog"
               Value="InstallDirDlg"
               Order="2" />
      <Publish Dialog="InstallDirDlg"
               Control="Back"
               Event="NewDialog"
               Value="WelcomeDlg"
               Order="2" />
    </UI>
  </Package>
</Wix>
