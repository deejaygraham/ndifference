<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>NDifference.Installer</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <PublishDir>$(MSBuildThisFileDirectory)..\artifacts\publish\win-x64\</PublishDir>
    <DefineConstants>PublishDir=$(PublishDir);IconFilePath=$(MSBuildThisFileDirectory)..\src\UI\ndifference.ico</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <ProjectReference Include="..\src\UI\UI.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="PublishApplication" BeforeTargets="CoreCompile">
    <MSBuild
      Projects="..\src\UI\UI.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=false;PublishDir=$(PublishDir)" />
  </Target>
</Project>
